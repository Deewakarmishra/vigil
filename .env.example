# ============================================================
# Vigil — AML Alert-Triage & SAR-Drafting Agent
# Copy this file to `.env` and adjust. The platform runs in
# mock mode by default, so the demo works end-to-end with
# ZERO API keys.
# ============================================================

# --- Application ---
APP_ENV=development                  # development | staging | production
APP_NAME=vigil
APP_HOST=127.0.0.1
APP_PORT=8000
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
LOG_FORMAT=console                   # json | console

# --- Security ---
# 32-byte URL-safe base64 Fernet key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=__PLACEHOLDER__
SESSION_SECRET=__PLACEHOLDER__

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vigil
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_POOL_SIZE=5
POSTGRES_POOL_MAX_OVERFLOW=10

# --- Redis / RQ (production async path; demo triages inline, no Redis needed) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
RQ_QUEUE_DEFAULT=vigil:default

# --- Connector mode ---
CONNECTOR_MODE=mock                  # mock | live

# --- Agent providers ---
USE_LLM=false
ANTHROPIC_API_KEY=__PLACEHOLDER__
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- AML / triage policy knobs ---
AUTO_MIN_CONFIDENCE=0.60             # below this, route to an officer
CTR_THRESHOLD=10000                  # CTR reporting threshold (structuring sits just beneath)
BASELINE_TOLERANCE=1.2               # observed within this × the expected ceiling reads as explained
STRUCTURING_MIN_COUNT=3              # cash deposits under CTR to flag structuring

# --- Live connectors (only used when CONNECTOR_MODE=live) ---
TM_PROVIDER=mock                     # mock | actimize | unit21 | inhouse
TM_API_KEY=__PLACEHOLDER__
CASEMGMT_PROVIDER=mock               # mock | fincen_efile
CASEMGMT_API_KEY=__PLACEHOLDER__

# --- Demo seed ---
DEMO_BRAND_SLUG=meridian
DEMO_ADMIN_EMAIL=admin@vigil.demo
DEMO_ADMIN_PASSWORD=demo-admin-password
